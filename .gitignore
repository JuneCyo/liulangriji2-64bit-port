# Publish only the project sources and public documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/android/
!/pc/
!/web/
!/tools/
!/docs/
/tools/*
!/tools/build_android.py
!/tools/build_pc.py
!/tools/build_web_engine.cjs
!/tools/download_dependencies.py
!/tools/prepare_web.py
!/tools/js-build/
/tools/js-build/*
!/tools/js-build/package.json
!/tools/js-build/package-lock.json
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.p12
**/*.jks
**/*.keystore
**/.env*
**/keystore-password.txt
